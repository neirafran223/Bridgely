PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL="postgresql://user:password@localhost:5432/bridgely"
JWT_SECRET="your-secret-key-here"

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# SMTP Configuration (optional - emails won't send without this)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sentry (optional - error monitoring)
SENTRY_DSN=
